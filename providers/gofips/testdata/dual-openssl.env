# The container for OpenSSL 3.6.5 (as the node images ship libcrypto.so.3)
# beside OpenSSL 4.0.3, used by capture/run.sh and run-dual-openssl.sh.
# Image by digest, packages by version.
WOLFI_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26
WOLFI_PACKAGES="openssl=3.6.5-r6 openssl-dev=3.6.5-r6 openssl-3.6-libcrypto=3.6.5-r6 openssl-3.6-libssl=3.6.5-r6 openssl-4.0-libcrypto=4.0.3-r8 go-1.26=1.26.11-r0 build-base=1-r11 bash=5.3-r14 coreutils=9.12-r8 pkgconf=3.0.11-r1"
# OpenSSL 4.0.3 headers, installed into their own root, to build gofips.so
# as the images ship it.
OSSL4_HEADERS=openssl-4.0-dev=4.0.3-r8
