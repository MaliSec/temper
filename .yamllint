---
# Applies to CI workflows, image configs and recipes.
# Run: yamllint .   (or: make lint)
extends: default

rules:
  line-length:
    max: 120
    level: warning
  document-start:
    present: true
    level: warning
  truthy:
    allowed-values: ['true', 'false']
    # allow `on:` as a key (GitHub Actions trigger syntax)
    check-keys: false
    level: error
  comments:
    min-spaces-from-content: 1
    level: warning
